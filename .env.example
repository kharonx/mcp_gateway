# ── Microsoft Entra ID ────────────────────────────────────────────────
# Tenant (directory) ID of your M365 tenant
TENANT_ID=00000000-0000-0000-0000-000000000000
# App registration (client) ID of the Reporting MCP application
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret - required only for HTTP mode (On-Behalf-Of flow).
# stdio/device-code mode works without it (public client).
CLIENT_SECRET=

# ── Server ────────────────────────────────────────────────────────────
# http = remote web app (Streamable HTTP + Entra OAuth), stdio = local client
MCP_MODE=http
PORT=3000
# Public base URL of this server (used in OAuth protected-resource metadata)
BASE_URL=http://localhost:3000

# ── Profile / safety ──────────────────────────────────────────────────
# Comma separated toolset filter. Empty = all toolsets of the Reporting profile.
# Available: mail,mail-write,shared-mail,shared-mail-write,calendar,teams,
#            meetings,onenote,sharepoint,onedrive,loop,search,users
ENABLED_TOOLSETS=
# true = strip every write tool (mail send/draft) regardless of toolsets
READ_ONLY=false

# ── Limits ────────────────────────────────────────────────────────────
# Default/maximum items returned by paginated list tools
DEFAULT_PAGE_ITEMS=50
MAX_PAGE_ITEMS=500
# Max attachment/file size fetched into context (bytes)
MAX_DOWNLOAD_BYTES=10485760

# ── Audit / admin ─────────────────────────────────────────────────────
AUDIT_DIR=./logs
# Key required for the /admin dashboard and /admin/api endpoints
ADMIN_KEY=change-me
